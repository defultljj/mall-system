<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1.项目坐标(与资料 pom 保持一致) -->
    <groupId>com.gec.it</groupId>
    <artifactId>mall-sys</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <!-- 2.父工程: Spring Boot 2.6.13.
         2.6.x 仍是 javax 命名空间, 资料代码里的 javax.servlet.* import 全部不用改。
         (资料原为 2.3.7.RELEASE, 升到 2.6.13 是为了对齐本机 CampusTrading 已验证可用的版本线) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.13</version>
        <relativePath></relativePath>
    </parent>

    <properties>
        <!-- JDK 版本(本机环境为 17, 与 CampusTrading 一致) -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Lombok 版本: 资料 pom 中就是用 ${lombok.version} 属性占位, 这里把版本提到 1.18.42
             (JDK 17+ 编译要求 Lombok >= 1.18.30; 本机本地仓库已缓存 1.18.42) -->
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <dependencies>
        <!-- 1.Web 支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 2.测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 3.Lombok: provided, 编译期生效, 不打包 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- 4.MyBatis-Plus(资料 3.4.2 → 3.5.3.1:
              3.5.x 中 MetaObjectHandler 改由 Spring 容器自动托管,
              不再需要资料里 MybatisConfig 手动 new + GlobalConfig 的老式写法) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.3.1</version>
        </dependency>
        <!-- 5.MySQL 驱动(MySQL 8) -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 6.密码加密(登录/注册模块用): spring-security-crypto 只提供 BCrypt 等纯算法工具类,
             不引入完整 Spring Security 的过滤器链, 不影响现有无鉴权框架的架构。
             不写版本, 由 spring-boot-dependencies 2.6.13 BOM 管理(spring-security 5.6.8) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 7.Redis(9.11 资料): spring-boot-starter-data-redis 默认用 Lettuce 客户端,
             提供 RedisTemplate/StringRedisTemplate 以及连接工厂的自动配置。
             版本不写, 由 spring-boot-dependencies 2.6.13 BOM 管理(spring-data-redis 2.6.8) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 8.Redis 连接池: Lettuce 只有在类路径上有 commons-pool2 时才能启用连接池,
             否则 application.properties 里的 spring.redis.lettuce.pool.* 会导致启动报错
             (讲师资料同款: 两个依赖一起加, 版本同样交给 BOM 管理) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 版本继承自 spring-boot-starter-parent, 无需显式书写 -->
            </plugin>
        </plugins>
        <!-- 自定义 JAR 包名称(与资料一致) -->
        <finalName>mall-sys-1.0</finalName>
    </build>

</project>
