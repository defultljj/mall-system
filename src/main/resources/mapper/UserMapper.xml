<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    UserMapper.xml — 用户联表分页查询
    Page<UserBO> getList( Page page, @Param("param") Map<String, Object> param );
    1. tbl_user  LEFT JOIN tbl_dept      → 拿 dept_name(部门名)
       同时      LEFT JOIN tbl_user_role + tbl_role → 拿 role_name(角色名)
    2. 搜索条件全部走 param Map(账号/姓名/手机号 模糊, 部门 精确); param 缺省/为空时不过滤
    3. 分页由 MyBatis-Plus 的 PaginationInnerInterceptor 完成(方法第一个参数是 Page), 本文件不写 limit
    4. 排序固定 order by user.id, 保证分页结果稳定
-->
<mapper namespace="com.gec.dao.UserMapper">

    <select id="getList" resultType="com.gec.domain.bo.UserBO">
        <include refid="list_fields"/>
        FROM tbl_user u
        LEFT JOIN tbl_dept  d  ON d.id = u.dept_id
        <!-- 注意: 关联表的别名不要用 ur 这种短名 —— MyBatis-Plus 分页插件在做 count
             SQL 优化时, 内置的 JSqlParser 会把别名 "ur" 误判成关键字(ISOLATION)而解析失败,
             导致每次分页都先打一段 ParseException 堆栈再退回子查询统计。 -->
        LEFT JOIN tbl_user_role u_role ON u_role.user_id = u.id
        LEFT JOIN tbl_role  r  ON r.id = u_role.role_id
        <include refid="list_where"/>
        ORDER BY u.id
    </select>

    <!-- 查询列: 别名直接写成 UserBO 的属性名(驼峰), 由 resultType 自动映射 -->
    <sql id="list_fields">
        SELECT
            u.id          AS id,
            u.account     AS account,
            u.nick_name   AS nickName,
            u.phone       AS phone,
            u.sex         AS sex,
            u.no          AS no,
            u.dept_id     AS deptId,
            u.status      AS status,
            d.dept_name   AS deptName,
            r.id          AS roleId,
            r.role_name   AS roleName,
            u.create_date AS createDate
    </sql>

    <!-- 动态搜索条件: param 为 null, 或 Map 里没有对应键 / 值为空时, 自动跳过该条件 -->
    <sql id="list_where">
        <where>
            <if test="param != null">
                <if test="param.account != null and param.account != ''">
                    AND u.account LIKE CONCAT('%', #{param.account}, '%')
                </if>
                <if test="param.nickName != null and param.nickName != ''">
                    AND u.nick_name LIKE CONCAT('%', #{param.nickName}, '%')
                </if>
                <if test="param.phone != null and param.phone != ''">
                    AND u.phone LIKE CONCAT('%', #{param.phone}, '%')
                </if>
                <if test="param.deptId != null">
                    AND u.dept_id = #{param.deptId}
                </if>
                <if test="param.status != null">
                    AND u.status = #{param.status}
                </if>
            </if>
        </where>
    </sql>

</mapper>
